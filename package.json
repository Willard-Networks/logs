{
    "name": "helix-logs",
    "version": "1.1.0",
    "description": "A logger for the Helix roleplaying framework written in Node.js with Typescript.",
    "repository": {
        "type": "git",
        "url": "https://github.com/wildflowericecoffee/helix-logs"
    },
    "author": "wildflowericecoffee",
    "license": "MIT",
    "scripts": {
        "build-sass": "sass src/public/css/main.scss dist/public/css/main.css",
        "build-ts": "tsc",
        "build": "npm run build-sass && npm run build-ts && npm run lint && npm run copy-static-assets",
        "copy-static-assets": "ts-node copyStaticAssets.ts",
        "debug": "npm run build && npm run watch-debug",
        "lint": "tsc --noEmit && eslint \"**/*.{js,ts}\" --quiet --fix",
        "serve-debug": "nodemon --inspect dist/server.js -e js,ejs",
        "serve": "node dist/server.js",
        "start": "npm run serve",
        "test": "jest --forceExit --coverage --verbose",
        "watch-debug": "concurrently -k -p \"[{name}]\" -n \"Sass,TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run watch-sass\" \"npm run watch-ts\" \"npm run serve-debug\"",
        "watch-node": "nodemon dist/server.js -e js,ejs",
        "watch-sass": "sass --watch src/public/css/main.scss dist/public/css/main.css",
        "watch-test": "npm run test -- --watchAll",
        "watch-ts": "tsc -w",
        "watch": "concurrently -k -p \"[{name}]\" -n \"Sass,TypeScript,Node\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run watch-sass\" \"npm run watch-ts\" \"npm run watch-node\""
    },
    "dependencies": {
        "body-parser": "^1.20.9",
        "compression": "^1.8.2",
        "connect-redis": "^7.1.1",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "ejs": "^3.1.10",
        "errorhandler": "^1.5.2",
        "express": "^4.22.3",
        "express-rate-limit": "^7.5.1",
        "express-session": "^1.19.0",
        "lusca": "1.7.0",
        "mysql2": "^3.24.6",
        "passport": "^0.7.0",
        "passport-steam": "^1.0.18",
        "redis": "^4.7.1",
        "steamid": "^2.1.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.15.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/errorhandler": "^1.5.3",
        "@types/express": "^4.17.25",
        "@types/express-session": "^1.19.0",
        "@types/jest": "^29.5.14",
        "@types/jquery": "^3.5.34",
        "@types/lusca": "^1.7.5",
        "@types/node": "^22.20.5",
        "@types/passport": "^1.0.17",
        "@types/passport-steam": "^1.0.6",
        "@types/shelljs": "^0.10.0",
        "@types/steamid": "^2.0.4",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "concurrently": "^9.2.5",
        "eslint": "^9.39.5",
        "jest": "^29.7.0",
        "nodemon": "^3.1.14",
        "sass": "^1.107.1",
        "shelljs": "^0.10.0",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
